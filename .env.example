# Eve Online ESI OAuth2 credentials
# Register your app at: https://developers.eveonline.com/
ESI_CLIENT_ID=your_client_id_here
ESI_CLIENT_SECRET=your_client_secret_here

# Callback URL — must exactly match what you registered on ESI developer portal
# Dev: http://localhost:5000/callback
# Prod: https://yourdomain.com/callback
ESI_CALLBACK_URL=http://localhost:5000/callback

# Flask secret key — generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change_me_to_a_random_secret

# Optional: override host/port
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
FLASK_DEBUG=true
